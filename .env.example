# Copy to .env (gitignored) and fill in on each machine. Never commit real values.
# This file just records WHICH integrations this workspace knows about —
# see .claude/SETUP.md for what each one is used for.

# Stage 3 (ai-broll) fallback video/image generation when Higgsfield's
# connector isn't available in the session.
KIE_API_KEY=

# Optional voiceover / TTS generation. Leave blank if this machine doesn't use it.
ELEVENLABS_API_KEY=

# Optional AI avatar / talking-head generation. Leave blank if this machine doesn't use it.
HEYGEN_API_KEY=
